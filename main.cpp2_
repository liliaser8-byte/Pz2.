#include <iostream>
#include <forward_list>
#include <string>

using namespace std;

int main()
{
    forward_list<string> genres = { "Рок" };
    genres.push_front("Поп");
    genres.push_front("Джаз");
    
    cout << "Список жанрів:" << endl;
    for (string genre : genres)
    {
        cout << genre << endl;
    }
    
    genres.pop_front();
    
    cout << endl;
    cout << "Після видалення першого жанру:" << endl;
    for (string genre : genres)
    {
        cout << genre << endl;
    }
    
    return 0;
}